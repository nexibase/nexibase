generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int             @id @default(autoincrement())
  uuid          String          @unique @default(uuid()) @db.VarChar(36)
  email         String          @unique @db.VarChar(255)
  nickname      String          @unique @db.VarChar(100)
  password      String?         @db.VarChar(255)
  image         String?         @db.VarChar(500)
  role          String          @default("user") @db.VarChar(20)
  status        String          @default("active") @db.VarChar(20)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?         @db.VarChar(50)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  adminNote     String?         @db.Text
  name          String?         @db.VarChar(50)
  phone         String?         @db.VarChar(20)
  level         Int             @default(1)
  provider      String?         @db.VarChar(50)
  providerId    String?         @db.VarChar(255)
  faqFeedback   FaqFeedback[]
  faqViews      FaqView[]
  posts         Post[]
  comments      Comment[]
  reactions     Reaction[]
  accounts      Account[]
  withdrawalJobs         WithdrawalJob[]
  notifications          Notification[]
  notificationEvents     NotificationEvent[]
  notificationPreference NotificationPreference?
  conversationsAsUser1   Conversation[] @relation("ConversationUser1")
  conversationsAsUser2   Conversation[] @relation("ConversationUser2")
  sentMessages           Message[]      @relation("MessageSender")
  addresses              UserAddress[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                Int      @id @default(autoincrement())
  userId            Int
  type              String   @db.VarChar(50)
  provider          String   @db.VarChar(50)
  providerAccountId String   @db.VarChar(255)
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?  @db.VarChar(50)
  scope             String?  @db.VarChar(255)
  id_token          String?  @db.Text
  session_state     String?  @db.VarChar(255)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Audit log + retry queue for user withdrawals. One row per withdrawal event. Retained indefinitely.
model WithdrawalJob {
  id           Int       @id @default(autoincrement())
  userId       Int
  status       String    @default("pending") @db.VarChar(20)   // 'pending' | 'running' | 'done' | 'failed'
  attempts     Int       @default(0)
  lastError    String?   @db.Text
  reasonCode   String?   @db.VarChar(40)                         // 'rarely_used' | 'no_feature' | 'moved_service' | 'privacy' | 'other' | null
  reasonText   String?   @db.VarChar(500)                        // free text when reasonCode = 'other'
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@index([status, startedAt])
  @@map("withdrawal_jobs")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model UserAddress {
  id             Int      @id @default(autoincrement())
  userId         Int
  name           String   @db.VarChar(50)
  recipientName  String   @db.VarChar(50)
  recipientPhone String   @db.VarChar(20)
  zipCode        String   @db.VarChar(10)
  address        String   @db.VarChar(200)
  addressDetail  String?  @db.VarChar(100)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_addresses")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  message   String    @db.Text
  link      String?   @db.VarChar(500)
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  eventId   String?   @unique @db.VarChar(36)
  event     NotificationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  postComment       Boolean  @default(true)
  commentReply      Boolean  @default(true)
  mention           Boolean  @default(true)
  orderStatus       Boolean  @default(true)
  emailPostComment  Boolean  @default(false)
  emailCommentReply Boolean  @default(false)
  emailMention      Boolean  @default(false)
  emailOrderStatus    Boolean  @default(true)
  emailDirectMessage  Boolean  @default(false)
  mobilePreferences   Json?
  updatedAt           DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationConfig {
  id               String   @id @db.VarChar(20)
  settings         Json
  secretsEncrypted String?  @db.Text
  updatedAt        DateTime @updatedAt
  @@map("notification_config")
}

model NotificationRule {
  eventType       String  @id @db.VarChar(50)
  label           String  @db.VarChar(100)
  preferenceType  String  @db.VarChar(50)
  owner           String  @default("core") @db.VarChar(50)
  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(false)
  alimtalkEnabled Boolean @default(false)
  smsTemplate     String  @db.Text
  alimtalkCode    String  @default("") @db.VarChar(100)
  alimtalkTemplate String @db.Text
  alimtalkButtons Json?
  variableMapping Json?
  updatedAt       DateTime @updatedAt
  @@map("notification_rules")
}

model NotificationEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  dedupeKey   String   @unique @db.Char(64)
  userId      Int
  type        String   @db.VarChar(50)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification?
  deliveries  NotificationDelivery[]
  @@index([userId])
  @@map("notification_events")
}

model NotificationDelivery {
  id               String   @id @default(uuid()) @db.VarChar(36)
  eventId          String   @db.VarChar(36)
  channel          String   @db.VarChar(20)
  status           String   @default("pending") @db.VarChar(20)
  recipientMasked  String   @db.VarChar(255)
  payloadEncrypted String?  @db.LongText
  providerId       String?  @db.VarChar(100)
  providerCode     String?  @db.VarChar(50)
  reason           String?  @db.VarChar(500)
  attempts         Int      @default(0)
  nextAttemptAt    DateTime @default(now())
  lockedAt         DateTime?
  lockToken        String?  @db.VarChar(36)
  acceptedAt       DateTime?
  completedAt      DateTime?
  lastCheckedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  event            NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([eventId, channel])
  @@index([status, nextAttemptAt])
  @@index([status, lastCheckedAt])
  @@index([createdAt])
  @@map("notification_deliveries")
}

model Menu {
  id         Int      @id @default(autoincrement())
  parentId   Int?
  position   String   @db.VarChar(20)
  groupName  String?  @db.VarChar(50)
  label      String   @db.VarChar(100)
  url        String   @db.VarChar(500)
  icon       String?  @db.VarChar(50)
  target     String   @default("_self") @db.VarChar(10)
  visibility String   @default("all") @db.VarChar(10)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  parent     Menu?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Menu[]   @relation("MenuTree")

  @@index([position, sortOrder])
  @@index([parentId])
  @@map("menus")
}

model WidgetPage {
  id               Int          @id @default(autoincrement())
  title            String       @db.VarChar(200)
  slug             String       @unique @db.VarChar(200)
  layoutTemplate   String       @default("full-width") @db.VarChar(30)
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  seoTitle         String?      @db.VarChar(200)
  seoDescription   String?      @db.VarChar(500)
  seoOgImage       String?      @db.VarChar(500)
  seoOgTitle       String?      @db.VarChar(200)
  seoOgDescription String?      @db.VarChar(500)
  seoCanonical     String?      @db.VarChar(500)
  seoNoIndex       Boolean      @default(false)
  seoNoFollow      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  widgets          PageWidget[]

  @@index([slug])
  @@index([isActive])
  @@map("widget_pages")
}

model PageWidget {
  id         Int         @id @default(autoincrement())
  pageId     Int
  widgetKey  String      @db.VarChar(50)
  widgetType String      @default("registry") @db.VarChar(20)
  zone       String      @db.VarChar(20)
  title      String      @db.VarChar(100)
  settings   String?     @db.Text
  colSpan    Int         @default(1)
  rowSpan    Int         @default(1)
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  page       WidgetPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, zone, sortOrder])
  @@map("page_widgets")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  ip        String   @db.VarChar(50)
  success   Boolean
  reason    String?  @db.VarChar(100)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model Conversation {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid()) @db.VarChar(36)
  user1Id         Int
  user2Id         Int
  lastMessageAt   DateTime?
  user1LastReadAt DateTime?
  user2LastReadAt DateTime?
  user1HiddenAt   DateTime?
  user2HiddenAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]
  user1           User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id, lastMessageAt])
  @@index([user2Id, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

/// 동의 이력. append-only — 철회도 새 행으로 남긴다.
/// IP와 User-Agent는 저장하지 않는다 (데이터 최소화).
model ConsentLog {
  id            Int      @id @default(autoincrement())
  /// 익명 UUID. 로그인 여부와 무관하게 방문자를 묶는 축.
  consentId     String   @db.VarChar(36)
  /// 동의 시점에 로그인 상태였을 때만 채운다. 관계는 걸지 않는다.
  userId        Int?
  analytics     Boolean  @default(false)
  marketing     Boolean  @default(false)
  /// 동의 시점의 활성 개인정보처리방침 버전
  policyVersion String?  @db.VarChar(20)
  bannerVersion String   @db.VarChar(20)
  /// accept_all | reject_all | save_custom | withdraw
  action        String   @db.VarChar(20)
  createdAt     DateTime @default(now())

  @@index([consentId])
  @@index([createdAt])
  @@map("consent_logs")
}

// Core publishing models (existing table mappings are preserved).

model Board {
  id                Int      @id @default(autoincrement())
  slug              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(100)
  description       String?  @db.VarChar(500)
  category          String?  @db.VarChar(50)
  listMemberOnly    Boolean  @default(false)
  readMemberOnly    Boolean  @default(false)
  writeMemberOnly   Boolean  @default(true)
  commentMemberOnly Boolean  @default(true)
  useComment        Boolean  @default(true)
  useReaction       Boolean  @default(true)
  useFile           Boolean  @default(true)
  useSecret         Boolean  @default(false)
  postsPerPage      Int      @default(20)
  dailyPostLimit    Int      @default(0)
  dailyCommentLimit Int      @default(0)
  sortOrder         String   @default("latest") @db.VarChar(20)
  isActive          Boolean  @default(true)
  postCount         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  displayType       String   @default("list") @db.VarChar(20)
  showPostNumber    Boolean  @default(false)
  posts             Post[]

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@map("boards")
}

model Post {
  id           Int              @id @default(autoincrement())
  boardId      Int
  authorId     Int
  title        String           @db.VarChar(200)
  content      String           @db.LongText
  status       String           @default("published") @db.VarChar(20)
  isNotice     Boolean          @default(false)
  isSecret     Boolean          @default(false)
  viewCount    Int              @default(0)
  likeCount    Int              @default(0)
  commentCount Int              @default(0)
  ip           String?          @db.VarChar(50)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  comments     Comment[]
  attachments  PostAttachment[]
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  board        Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  reactions    Reaction[]

  @@index([boardId])
  @@index([authorId])
  @@index([authorId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@fulltext([title, content])
  @@map("posts")
}

model PostAttachment {
  id            Int      @id @default(autoincrement())
  postId        Int
  filename      String   @db.VarChar(255)
  storedName    String   @db.VarChar(255)
  filePath      String   @db.VarChar(500)
  fileSize      Int
  mimeType      String   @db.VarChar(100)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  sortOrder     Int      @default(0)
  thumbnailPath String?  @db.VarChar(500)
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_attachments")
}

model Comment {
  id        Int        @id @default(autoincrement())
  postId    Int
  authorId  Int
  parentId  Int?
  content   String     @db.Text
  status    String     @default("published") @db.VarChar(20)
  isSecret  Boolean    @default(false)
  likeCount Int        @default(0)
  ip        String?    @db.VarChar(50)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("CommentReplies")
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([postId])
  @@index([authorId])
  @@index([authorId, createdAt])
  @@index([parentId])
  @@index([createdAt])
  @@map("comments")
}

model Reaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int?
  commentId Int?
  type      String   @db.VarChar(20)
  createdAt DateTime @default(now())
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId])
  @@index([commentId])
  @@map("reactions")
}

model Content {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(100)
  title     String   @db.VarChar(200)
  content   String   @db.LongText
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isPublic])
  @@map("contents")
}

model Policy {
  id        Int      @id @default(autoincrement())
  slug      String   @db.VarChar(100)
  version   String   @db.VarChar(20)
  title     String   @db.VarChar(200)
  content   String   @db.LongText
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, version])
  @@index([slug, isActive])
  @@map("policies")
}

// Core FAQ models; existing FAQ tables and columns remain unchanged.
model FaqCategory {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faqs      Faq[]

  @@index([sortOrder])
  @@map("faq_categories")
}

model Faq {
  id          Int      @id @default(autoincrement())
  question    String   @db.VarChar(500)
  answer      String   @db.Text
  categoryId  Int
  sortOrder   Int      @default(0)
  views       Int      @default(0)
  helpful     Int      @default(0)
  notHelpful  Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feedback    FaqFeedback[]
  viewRecords FaqView[]
  category    FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([views])
  @@index([published])
  @@map("faqs")
}


// One immutable evaluation per question and authenticated user or signed visitor.
model FaqFeedback {
  id        Int      @id @default(autoincrement())
  faqId     Int
  voterKey  String   @db.VarChar(64)
  userId    Int?
  helpful   Boolean
  createdAt DateTime @default(now())

  faq       Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([faqId, voterKey])
  @@index([userId])
  @@map("faq_feedback")
}


// One recorded view per question and authenticated user or signed visitor.
model FaqView {
  id        Int      @id @default(autoincrement())
  faqId     Int
  viewerKey String   @db.VarChar(64)
  userId    Int?
  createdAt DateTime @default(now())

  faq       Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([faqId, viewerKey])
  @@index([userId])
  @@map("faq_views")
}
